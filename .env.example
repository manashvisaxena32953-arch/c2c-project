# Copy to .env and fill in your own values. Never share or commit the real .env.

# --- LinkedIn (optional: only pre-fills the login form; you complete login manually) ---
LINKEDIN_EMAIL=your_linkedin_email
LINKEDIN_PASSWORD=your_linkedin_password

# --- Gmail (SMTP/IMAP). Use a Gmail App Password, NOT your normal password ---
GMAIL_EMAIL=your_gmail_address
GMAIL_APP_PASSWORD=your_gmail_app_password

# --- AI providers (at least one is needed to tailor resumes) ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# --- Optional ---
LEAD_EMAIL=
ADMIN_EMAIL=
EMAIL_DELAY_SECONDS=3
FOLLOWUP_DAYS=7
IMAP_FALLBACK_DAYS=30
